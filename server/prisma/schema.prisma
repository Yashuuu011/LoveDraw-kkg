datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  name             String
  username         String?           @unique
  email            String?           @unique
  phone            String?           @unique
  passwordHash     String?
  otpCode          String?
  otpExpiresAt     DateTime?
  avatarUrl        String?
  bio              String?
  dateOfBirth      DateTime?
  isOnline         Boolean           @default(false)
  lastSeen         DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  entries          Entry[]
  winners          Winner[]
  favorites        FavoriteMessage[]
  sentMessages     ChatMessage[]     @relation("SentMessages")
  chatRooms        ChatParticipant[]
  friendships      Friendship[]      @relation("UserFriendships")
  friendOf         Friendship[]      @relation("FriendToUser")
  sentRequests     FriendRequest[]   @relation("SentRequests")
  receivedRequests FriendRequest[]   @relation("ReceivedRequests")
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

model DailyMessage {
  id        String            @id @default(uuid())
  message   String
  category  String
  active    Boolean           @default(true)
  usedDate  String?
  createdAt DateTime          @default(now())
  favorites FavoriteMessage[]
}

model FavoriteMessage {
  id        String       @id @default(uuid())
  userId    String
  messageId String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   DailyMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
}

model Draw {
  id               String     @id @default(uuid())
  title            String
  description      String
  type             String     @default("MONTHLY") // WEEKLY, MONTHLY, SPECIAL
  startDate        DateTime
  endDate          DateTime
  drawDate         DateTime
  status           String     @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, CLOSED
  prizeTitle       String
  prizeDescription String
  prizeImage       String
  entryPriceINR    Int        @default(99)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  entries          Entry[]
  winner           Winner?
  memories         Memory[]
  auditLogs        AuditLog[]
}

model Entry {
  id            String   @id @default(uuid())
  userId        String
  drawId        String
  referenceCode String   @unique
  status        String   @default("COMPLETED")
  paymentMode   String   @default("DEMO")
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  draw          Draw     @relation(fields: [drawId], references: [id], onDelete: Cascade)
  winner        Winner?
}

model Winner {
  id               String   @id @default(uuid())
  drawId           String   @unique
  entryId          String   @unique
  userId           String
  selectedAt       DateTime @default(now())
  announcementNote String?
  draw             Draw     @relation(fields: [drawId], references: [id], onDelete: Cascade)
  entry            Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Memory {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String
  date        DateTime @default(now())
  drawId      String?
  winnerName  String?
  createdAt   DateTime @default(now())
  draw        Draw?    @relation(fields: [drawId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id          String   @id @default(uuid())
  drawId      String?
  action      String
  performedAt DateTime @default(now())
  metadata    String?
  draw        Draw?    @relation(fields: [drawId], references: [id], onDelete: SetNull)
}

model ChatRoom {
  id           String            @id @default(uuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  participants ChatParticipant[]
  messages     ChatMessage[]
}

model ChatParticipant {
  id         String   @id @default(uuid())
  chatRoomId String
  userId     String
  joinedAt   DateTime @default(now())
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, userId])
}

model ChatMessage {
  id         String   @id @default(uuid())
  chatRoomId String
  senderId   String
  content    String? // Text content
  mediaUrl   String? // Base64 or URL for image/video/audio
  mediaType  String? // IMAGE, VIDEO, AUDIO
  createdAt  DateTime @default(now())
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model FriendRequest {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sender     User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())
  user      User     @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendToUser", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}
