datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  entries      Entry[]
  winners      Winner[]
  favorites    FavoriteMessage[]
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

model DailyMessage {
  id        String            @id @default(uuid())
  message   String
  category  String
  active    Boolean           @default(true)
  usedDate  String?
  createdAt DateTime          @default(now())
  favorites FavoriteMessage[]
}

model FavoriteMessage {
  id        String       @id @default(uuid())
  userId    String
  messageId String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   DailyMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
}

model Draw {
  id               String     @id @default(uuid())
  title            String
  description      String
  type             String     @default("MONTHLY") // WEEKLY, MONTHLY, SPECIAL
  startDate        DateTime
  endDate          DateTime
  drawDate         DateTime
  status           String     @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, CLOSED
  prizeTitle       String
  prizeDescription String
  prizeImage       String
  entryPriceINR    Int        @default(99)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  entries          Entry[]
  winner           Winner?
  memories         Memory[]
  auditLogs        AuditLog[]
}

model Entry {
  id            String   @id @default(uuid())
  userId        String
  drawId        String
  referenceCode String   @unique
  status        String   @default("COMPLETED")
  paymentMode   String   @default("DEMO")
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  draw          Draw     @relation(fields: [drawId], references: [id], onDelete: Cascade)
  winner        Winner?
}

model Winner {
  id               String   @id @default(uuid())
  drawId           String   @unique
  entryId          String   @unique
  userId           String
  selectedAt       DateTime @default(now())
  announcementNote String?
  draw             Draw     @relation(fields: [drawId], references: [id], onDelete: Cascade)
  entry            Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Memory {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String
  date        DateTime @default(now())
  drawId      String?
  winnerName  String?
  createdAt   DateTime @default(now())
  draw        Draw?    @relation(fields: [drawId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id          String   @id @default(uuid())
  drawId      String?
  action      String
  performedAt DateTime @default(now())
  metadata    String?
  draw        Draw?    @relation(fields: [drawId], references: [id], onDelete: SetNull)
}
